<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>FSharp.Windows.Dsl.Codegen</RootNamespace>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>fsharp-wpf-codegen</ToolCommandName>
        <Description>Code generation tool for FSharp.Windows.Dsl — generates F# DSL wrappers from WPF assemblies</Description>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="Types.fs" />
        <Compile Include="AssemblyInspector.fs" />
        <Compile Include="TfmComparer.fs" />
        <Compile Include="HierarchyBuilder.fs" />
        <Compile Include="FSharpEmitter.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="System.Reflection.MetadataLoadContext" />
        <PackageReference Include="Argu" />
        <!-- Not used by the tool's code: restoring it puts the net461 reference
             assemblies in the NuGet cache, where the net461 baseline looks for them. -->
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net461" ExcludeAssets="all" PrivateAssets="all" />
    </ItemGroup>
</Project>
