<Project>
    <ItemGroup>
        <!-- Testing (xunit v3 requires OutputType=Exe in test projects) -->
        <PackageVersion Include="xunit.v3" Version="4.0.2"/>
        <PackageVersion Include="FsUnit.xUnit" Version="8.0.0"/>
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1"/>

        <!-- Source Link -->
        <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.403"/>

        <!-- Core -->
        <PackageVersion Include="FSharp.Core" Version="10.1.403"/>

        <!-- .NET Framework targeting (reference assemblies for net4x builds on machines without VS) -->
        <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3"/>

        <!-- BCL fillers needed only on .NET Framework targets -->
        <PackageVersion Include="System.Text.Json" Version="10.0.14"/>

        <!-- Elmish -->
        <PackageVersion Include="Elmish" Version="5.0.2"/>

        <!-- Codegen tool -->
        <PackageVersion Include="System.Reflection.MetadataLoadContext" Version="10.0.14"/>
        <PackageVersion Include="Argu" Version="6.2.5"/>
    </ItemGroup>
</Project>
